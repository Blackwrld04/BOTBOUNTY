# BotBounty Server Environment Configuration Example
#
# Copy to server/.env and fill in real values. Never commit server/.env.
# Secrets must be generated uniquely per deployment (e.g. `openssl rand -hex 32`).

# ==============================================================================
# Runtime
# ==============================================================================
NODE_ENV=development
PORT=4050

# Comma-separated list of browser origins allowed to call this API.
# Leave empty to allow only the built-in localhost development origins.
CORS_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Enable only when the app runs behind a trusted reverse proxy/load balancer
# (Render, Vercel, nginx). Required for correct client IPs and rate limiting.
TRUST_PROXY=false
# Set to true only on an HTTPS deployment.
ENABLE_HSTS=false

# ==============================================================================
# Database
# ==============================================================================
# Leave DB_PATH unset to use server/data/arcbounty.db.
# DB_PATH=:memory:
#
# Optional Supabase/PostgreSQL mirror.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# Email Delivery
# ==============================================================================
# Direct SMTP (server-side only).
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="BotBounty" <no-reply@example.com>

# Backward-compatible Gmail aliases.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional Resend API key.
RESEND_API_KEY=

# Serverless relay (client/api/send-email.js). Must match on both deployments
# and be at least 24 characters.
EMAIL_RELAY_SECRET=

# ==============================================================================
# BOT Chain Network
# ==============================================================================
BOT_RPC_URL=https://rpc.botchain.ai
BOT_CHAIN_ID=677
BOT_MAINNET_RPC_URL=https://rpc.botchain.ai
BOT_MAINNET_CHAIN_ID=677
BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_TESTNET_CHAIN_ID=968
ARC_RPC_URL=
ARC_CHAIN_ID=5042

# ==============================================================================
# Escrow Contract
# ==============================================================================
# Public on-chain address, not a secret.
ESCROW_CONTRACT_ADDRESS=0x909661b453bBe13Ee247551754b35370557A9aA2
USDT_ADDRESS=0xaBabc7Ddc03e501d190C676BF3d92ef0e6e87a3C
ENABLE_ERC20=false

# ==============================================================================
# Admin Access
# ==============================================================================
# Comma-separated allowlist. There are no built-in admin identities.
ADMIN_EMAILS=
ADMIN_WALLETS=
# Required. Minimum 16 characters and not a known/default value.
ADMIN_PASSWORD=

# ==============================================================================
# GitHub Webhook
# ==============================================================================
# Required for /api/bounties/github-webhook. Requests without a valid
# x-hub-signature-256 HMAC are rejected.
GITHUB_WEBHOOK_SECRET=
# Optional repo allowlist, e.g. owner/repository
GITHUB_WEBHOOK_REPO=

# ==============================================================================
# Google Sign-In
# ==============================================================================
# Comma-separated OAuth client IDs accepted in Google ID tokens.
GOOGLE_CLIENT_ID=

# ==============================================================================
# Tests / Scripts
# ==============================================================================
# Test-only on-chain verification bypass. Requires NODE_ENV=test as well.
# NEVER enable this in production.
ALLOW_UNVERIFIED_CHAIN_TXS=false

# Only for one-off local scripts; never place a funded production key here.
# MAINTAINER_PRIVATE_KEY=
# SOLVER_PRIVATE_KEY=
