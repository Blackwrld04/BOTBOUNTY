# BotBounty Client Environment Variables

# In production (Vercel):
# Set this in your Vercel Project Settings -> Environment Variables:
# VITE_API_URL=https://your-api.example.com

# For local development:
VITE_API_URL=http://localhost:4050

# Optional Google Identity Services client ID. When omitted, the Google button
# is hidden and only email/OTP and wallet sign-in are available.
VITE_GOOGLE_CLIENT_ID=
